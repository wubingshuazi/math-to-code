+    fn blank(n: usize) -> Counts {
+        Counts {
+            f_segs: Vec::new(), f_idx: vec![(0, 0); n],
+            r_segs: Vec::new(), r_idx: vec![(0, 0); n],
+            children_sum: vec![0; n], is_req: vec![false; n],
+            w: 0, bumps: FxMap::default(), passes: 0,
+        }
+    }
+
+    fn same(actual: &Counts, expected: &Counts) {
+        assert_eq!(actual.f_segs, expected.f_segs, "complete f buffer");
+        assert_eq!(actual.f_idx, expected.f_idx, "complete f index");
+        assert_eq!(actual.r_segs, expected.r_segs, "complete r buffer");
+        assert_eq!(actual.r_idx, expected.r_idx, "complete r index");
+        assert_eq!(actual.children_sum, expected.children_sum, "children sums");
+        assert_eq!(actual.is_req, expected.is_req, "required states");
+        assert_eq!(actual.w, expected.w, "W");
+        assert_eq!(actual.bumps, expected.bumps, "point lower bounds");
+        assert_eq!(actual.passes, expected.passes, "fixed-point passes");
+    }
