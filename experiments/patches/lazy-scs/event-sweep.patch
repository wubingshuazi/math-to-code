+    fn table_case(tables: &[Vec<(u32, u32)>], lo: u32, hi: u32) {
+        let mut c = blank(tables.len());
+        let mut row = Vec::new();
+        for (i, table) in tables.iter().enumerate() {
+            let offset = c.f_segs.len() as u32;
+            c.f_segs.extend_from_slice(table);
+            c.f_idx[i] = (offset, table.len() as u32);
+            row.push((i as u8, i as u32));
+        }
+        // Same union/all-successor loop as the original Rust implementation.
+        let mut points = vec![lo];
+        for &(_, y) in &row {
+            for &(start, _) in c.f(y) {
+                if start >= 1 && start - 1 >= lo && start - 1 <= hi {
+                    points.push(start - 1);
+                }
+            }
+        }
+        points.sort_unstable();
+        points.dedup();
+        let expected: Vec<(u32, u32)> = points.iter().map(|&length| {
+            (length, row.iter().map(|&(_, y)| ev(c.f(y), length + 1)).sum())
+        }).collect();
+        let mut actual = Vec::new();
+        let mut events = Vec::new();
+        c.aggregate_successors(&row, lo, hi, &mut actual, &mut events);
+        assert_eq!(actual, expected, "exact breakpoint list, lo={lo}, hi={hi}");
+        for length in lo..=hi {
+            // Linear lookup is independent of ev/partition_point.
+            let direct: u32 = tables.iter().map(|table| {
+                table.iter().rev().find(|&&(start, _)| start <= length + 1).unwrap().1
+            }).sum();
+            assert_eq!(ev(&actual, length), direct, "integer length {length}");
+        }
+    }
+
+    #[test]
+    fn boundary_and_zero_net_events() {
+        table_case(&[], 1, 1);
+        table_case(&[vec![(1, 5)]], 1, 10);
+        table_case(&[vec![(0, 9), (2, 7), (3, 7)]], 1, 2);
+        table_case(&[vec![(1, 10), (7, 8), (8, 5)]], 6, 6);
+        table_case(&[vec![(1, 5), (2, 3), (4, 0)],
+                     vec![(1, 0), (2, 2), (4, 5)]], 1, 4);
+        table_case(&[vec![(1, 9), (7, 5), (8, 2)],
+                     vec![(1, 9), (7, 5), (8, 2)]], 6, 7);
+        table_case(&[vec![(1, u32::MAX), (3, 0)],
+                     vec![(1, 0), (3, u32::MAX)]], 1, 4);
+    }
+
+    struct Rng(u64);
+    impl Rng {
+        fn below(&mut self, maximum: u32) -> u32 {
+            self.0 ^= self.0 << 13;
+            self.0 ^= self.0 >> 7;
+            self.0 ^= self.0 << 17;
+            (self.0 % maximum as u64) as u32
+        }
+    }
+
+    #[test]
+    fn randomized_step_tables_match_all_integer_lengths() {
+        let mut rng = Rng(1282026);
+        for case in 0..1000 {
+            let lo = 1 + rng.below(8);
+            let hi = lo + rng.below(101);
+            let mut tables = Vec::new();
+            for _ in 0..rng.below(33) {
+                let mut starts = vec![1];
+                for start in 2..hi + 5 {
+                    if rng.below(5) == 0 { starts.push(start); }
+                }
+                let mut values: Vec<u32> = starts.iter().map(|_| rng.below(1001)).collect();
+                if case % 2 == 0 { values.sort_unstable_by(|a, b| b.cmp(a)); }
+                tables.push(starts.into_iter().zip(values).collect());
+            }
+            table_case(&tables, lo, hi);
+        }
+    }
+
+    fn sam_case(strings: Vec<Vec<u8>>, texts: &[(usize, Vec<u8>)]) {
+        let sam = Sam::build(strings);
+        let order = sam.order_desc();
+        let actual = Counts::new(&sam, &order, texts);
+        let expected = Counts::new_reference(&sam, &order, texts);
+        same(&actual, &expected);
+        assert_eq!(actual.edges(&sam), expected.edges(&sam), "edge multiplicities");
+
+        // Recompute a complete pass with additional interior point bounds, so
+        // the bump-cut branch is tested even on inputs needing no lazy rule.
+        let mut a = blank(sam.n());
+        a.is_req = actual.is_req.clone();
+        a.bumps = actual.bumps.clone();
+        for x in 1..sam.n() as u32 {
+            let lo = sam.len[sam.link[x as usize] as usize] + 1;
+            let hi = sam.len[x as usize];
+            a.bumps.insert(key(x, lo + (hi - lo) / 2), 1 + (x % 7));
+        }
+        let mut b = blank(sam.n());
+        b.is_req = a.is_req.clone();
+        b.bumps = a.bumps.clone();
+        a.compute(&sam, &order);
+        b.compute_reference(&sam, &order);
+        same(&a, &b);
+    }
+
+    #[test]
+    fn exhaustive_small_binary_pairs_complete_state_parity() {
+        let mut words = vec![vec![]];
+        for length in 1..=4 {
+            for mask in 0..(1 << length) {
+                words.push((0..length).map(|i| b'a' + ((mask >> i) & 1) as u8).collect());
+            }
+        }
+        for a in &words {
+            for b in &words {
+                sam_case(vec![a.clone(), b.clone()], &[]);
+            }
+        }
+    }
+
+    #[test]
+    fn periodic_fixed_point_and_complete_state_parity() {
+        let texts = vec![(1, b"a".to_vec()), (1, b"b".to_vec()), (2, b"ab".to_vec())];
+        for words in [
+            vec![b"aaaaaa".to_vec()],
+            vec![b"abababab".to_vec(), b"babababa".to_vec()],
+            vec![b"cabababab".to_vec(), b"babababa".to_vec(), b"ababababc".to_vec()],
+            vec![b"baaaaac".to_vec(), b"caaaaab".to_vec()],
+            vec![vec![], b"a".to_vec(), b"ab".to_vec(), b"ba".to_vec()],
+        ] {
+            sam_case(words, &texts);
+        }
+    }
+
+    #[test]
+    fn randomized_real_automata_complete_state_parity() {
+        let mut rng = Rng(1282027);
+        for case in 0..100 {
+            let alphabet = [2, 4, 16, 128][case % 4];
+            let mut strings = Vec::new();
+            for _ in 0..1 + rng.below(12) {
+                strings.push((0..rng.below(33)).map(|_| rng.below(alphabet) as u8).collect());
+            }
+            sam_case(strings, &[]);
+        }
+    }
