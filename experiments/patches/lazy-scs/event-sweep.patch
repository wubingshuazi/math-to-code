+    // Experimental engineering change (100% GPT-generated), preserving the
+    // original lazy-scs algorithm and MIT attribution. Only aggregation changes.
+    // Every emitted point is retained, even if its total change is zero.
+    fn aggregate_successors(&self, row: &[(u8, u32)], lo: u32, hi: u32,
+                            out: &mut Vec<(u32, u32)>, events: &mut Vec<(u32, i64)>) {
+        out.clear();
+        if row.is_empty() {
+            out.push((lo, 0));
+            return;
+        }
+        if row.len() == 1 {
+            // The one successor is already sorted: neither sort nor events needed.
+            let f = self.f(row[0].1);
+            let first = f.partition_point(|s| s.0 <= lo + 1);
+            out.push((lo, f[first - 1].1));
+            for &(start, value) in &f[first..] {
+                if start > hi + 1 {
+                    break;
+                }
+                out.push((start - 1, value));
+            }
+            return;
+        }
+        events.clear();
+        let mut total = 0i64;
+        for &(_, y) in row {
+            let f = self.f(y);
+            let first = f.partition_point(|s| s.0 <= lo + 1);
+            let mut previous = f[first - 1].1;
+            total += previous as i64;
+            // Changes at lo are already incorporated by the initial evaluation.
+            for &(start, value) in &f[first..] {
+                if start > hi + 1 {
+                    break;
+                }
+                events.push((start - 1, value as i64 - previous as i64));
+                previous = value;
+            }
+        }
+        debug_assert!(total >= 0 && total <= u32::MAX as i64);
+        out.push((lo, total as u32));
+        events.sort_unstable_by_key(|event| event.0);
+        let mut i = 0;
+        while i < events.len() {
+            let position = events[i].0;
+            loop {
+                total += events[i].1;
+                i += 1;
+                if i == events.len() || events[i].0 != position {
+                    break;
+                }
+            }
+            debug_assert!(total >= 0 && total <= u32::MAX as i64);
+            out.push((position, total as u32));
+        }
+    }
