+#[derive(Default)]
+struct SegmentProfile {
+    total: usize,
+    max: usize,
+    // Segment counts: 0, 1, 2, 3, 4, 5..=8, 9..=16, 17..=64, >=65.
+    histogram: [usize; 9],
+}
+
+impl SegmentProfile {
+    fn add(&mut self, len: usize) {
+        self.total += len;
+        self.max = self.max.max(len);
+        let bin = match len {
+            0..=4 => len,
+            5..=8 => 5,
+            9..=16 => 6,
+            17..=64 => 7,
+            _ => 8,
+        };
+        self.histogram[bin] += 1;
+    }
+
+    fn json(&self) -> String {
+        format!("{{\"total\":{},\"max_per_state\":{},\"histogram\":{:?}}}",
+                self.total, self.max, self.histogram)
+    }
+}
+
+struct CountRoundProfile {
+    round: usize,
+    elapsed_ns: u128,
+    periodic_fixpoint_passes: usize,
+    f: Option<SegmentProfile>,
+    r: Option<SegmentProfile>,
+}
+
+impl SolveProfile {
+    /// Emit one record per instance. CLI total starts immediately before the
+    /// input clone and ends after coverage; it excludes parsing, output and JSON.
+    pub fn json(&self, coverage_verify_ns: u128, cli_total_ns: u128,
+                instance_index: usize, check: bool, verify_lb: bool) -> String {
+        let rounds: Vec<String> = self.rounds.iter().map(|r| {
+            let f = r.f.as_ref().map_or_else(|| "null".to_owned(), SegmentProfile::json);
+            let rev = r.r.as_ref().map_or_else(|| "null".to_owned(), SegmentProfile::json);
+            format!("{{\"round\":{},\"count_ns\":{},\"periodic_fixpoint_passes\":{},\"f_segments\":{},\"r_segments\":{}}}",
+                    r.round, r.elapsed_ns, r.periodic_fixpoint_passes, f, rev)
+        }).collect();
+        let sam_edges = if self.collect_tables { self.sam_edges.to_string() } else { "null".to_owned() };
+        format!(concat!(
+            "{{\"kind\":\"lazy_scs_stage_profile\",\"schema_version\":1,",
+            "\"mode\":\"{}\",\"instance_index\":{},\"check\":{},\"verify_lower_bound\":{},",
+            "\"timings_ns\":{{\"preprocess\":{},\"sam\":{},\"count\":{},\"construct\":{},",
+            "\"verify_lower_bound\":{},\"trim\":{},\"stats_collection\":{},\"solve_total\":{},",
+            "\"coverage_verify\":{},\"cli_total\":{}}},",
+            "\"cli_total_scope\":\"input_clone_solve_and_coverage_excludes_parse_and_output\",",
+            "\"counts\":{{\"input_strings\":{},\"input_chars\":{},\"reduced_strings\":{},",
+            "\"reduced_chars\":{},\"sam_states\":{},\"sam_edges\":{},\"count_calls\":{},",
+            "\"periodic_fixpoint_passes\":{},\"enabled_rules\":{}}},",
+            "\"histogram_bins\":[\"0\",\"1\",\"2\",\"3\",\"4\",\"5-8\",\"9-16\",\"17-64\",\"65+\"],",
+            "\"histogram_includes_root\":true,\"count_rounds\":[{}]}}"),
+            if self.collect_tables { "stats" } else { "timings" }, instance_index, check, verify_lb,
+            self.preprocess_ns, self.sam_ns, self.count_ns, self.construct_ns,
+            self.verify_lower_bound_ns, self.trim_ns, self.stats_collection_ns, self.solve_total_ns,
+            coverage_verify_ns, cli_total_ns, self.input_strings, self.input_chars,
+            self.reduced_strings, self.reduced_chars, self.sam_states, sam_edges,
+            self.count_calls, self.periodic_fixpoint_passes, self.enabled_rules, rounds.join(","))
+    }
+}
