+fn solve_profiled(strings: Vec<Vec<u8>>, check: bool, verify_lb: bool, collect_tables: bool) -> Solved {
+    let start = std::time::Instant::now();
+    let mut result = solve_profiled_inner(strings, check, verify_lb, collect_tables);
+    // Include destruction of the final SAM/count tables and temporary rules.
+    result.profile.as_mut().unwrap().solve_total_ns = start.elapsed().as_nanos();
+    result
+}
+
+fn solve_profiled_inner(strings: Vec<Vec<u8>>, check: bool, verify_lb: bool, collect_tables: bool) -> Solved {
+    use std::time::Instant;
+    let total_start = Instant::now();
+    let stats_start = Instant::now();
+    let mut profile = SolveProfile {
+        input_strings: strings.len(),
+        input_chars: strings.iter().map(Vec::len).sum(),
+        collect_tables,
+        ..Default::default()
+    };
+    profile.stats_collection_ns += stats_start.elapsed().as_nanos();
+    let start = Instant::now();
+    let req = sam::reduce_inputs(strings);
+    profile.preprocess_ns = start.elapsed().as_nanos();
+    let stats_start = Instant::now();
+    profile.reduced_strings = req.len();
+    profile.reduced_chars = req.iter().map(Vec::len).sum();
+    profile.stats_collection_ns += stats_start.elapsed().as_nanos();
+    if req.is_empty() {
+        profile.solve_total_ns = total_start.elapsed().as_nanos();
+        return Solved { superstring: vec![], w_ext: 0, w: 0, rounds: 0,
+                        stats: Default::default(), profile: Some(profile) };
+    }
+    let start = Instant::now();
+    let s = sam::Sam::build(req);
+    let order = s.order_desc();
+    profile.sam_ns = start.elapsed().as_nanos();
+    let stats_start = Instant::now();
+    profile.sam_states = s.n();
+    // This one linear metadata scan is restricted to the optional stats mode.
+    if collect_tables {
+        profile.sam_edges = s.next.iter().map(Vec::len).sum();
+    }
+    profile.stats_collection_ns += stats_start.elapsed().as_nanos();
+    let mut texts: Vec<(usize, Vec<u8>)> = Vec::new();
+    let mut w_ext = 0;
+    for round in 1.. {
+        let start = Instant::now();
+        let c = counts::Counts::new(&s, &order, &texts);
+        let count_ns = start.elapsed().as_nanos();
+        profile.count_ns += count_ns;
+        profile.count_calls += 1;
+        profile.periodic_fixpoint_passes += c.passes;
+        let stats_start = Instant::now();
+        let (f, r) = if collect_tables {
+            let mut f = SegmentProfile::default();
+            let mut r = SegmentProfile::default();
+            for x in 0..s.n() {
+                f.add(c.f(x as u32).len());
+                r.add(c.r(x as u32).len());
+            }
+            (Some(f), Some(r))
+        } else { (None, None) };
+        profile.rounds.push(CountRoundProfile {
+            round, elapsed_ns: count_ns, periodic_fixpoint_passes: c.passes, f, r,
+        });
+        profile.stats_collection_ns += stats_start.elapsed().as_nanos();
+        if round == 1 { w_ext = c.w; }
+        let start = Instant::now();
+        let outcome = approx::run(&s, &c, check);
+        profile.construct_ns += start.elapsed().as_nanos();
+        match outcome {
+            Ok(o) => {
+                let mut stats = o.stats;
+                stats.insert("count_passes", c.passes as u64);
+                if verify_lb {
+                    let start = Instant::now();
+                    let rep = verify::verify(&s, &c, &texts);
+                    profile.verify_lower_bound_ns += start.elapsed().as_nanos();
+                    stats.insert("verify_points", rep.checked_points);
+                    stats.insert("verify_unjustified", rep.unjustified);
+                    stats.insert("verify_ext_violations", rep.ext_violations);
+                }
+                stats.insert("untrimmed_length", o.superstring.len() as u64);
+                let start = Instant::now();
+                let trimmed = sam::trim(&o.superstring, &s.strings);
+                profile.trim_ns = start.elapsed().as_nanos();
+                profile.enabled_rules = texts.len();
+                profile.solve_total_ns = total_start.elapsed().as_nanos();
+                return Solved { superstring: trimmed, w_ext, w: o.w, rounds: round,
+                                stats, profile: Some(profile) };
             }
             Err(approx::NeedRule(p, g)) => {
