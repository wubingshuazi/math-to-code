 /// Drop leading then trailing letters while every input still occurs (never lengthens).
+/// Experimental engineering change: 100% GPT-generated, preserving lazy-scs's
+/// algorithm/MIT attribution. The matcher is aho-corasick by Andrew Gallant and
+/// contributors (MIT/Unlicense); this replaces two output-sized suffix automata.
 pub fn trim(t: &[u8], req: &[Vec<u8>]) -> Vec<u8> {
+    use aho_corasick::{AhoCorasick, MatchKind};
+    trim_with_builder(t, req, |patterns| {
+        AhoCorasick::builder().match_kind(MatchKind::Standard).build(patterns)
+    })
+}
+
+// A fallible builder keeps the legacy fallback testable without allocating the
+// billions of states/pattern bytes required to trigger the crate's opaque limits.
+// The production builder and its BuildError type are monomorphized at the call.
+fn trim_with_builder<E>(t: &[u8], req: &[Vec<u8>],
+                        build: impl FnOnce(&[&[u8]]) -> Result<aho_corasick::AhoCorasick, E>) -> Vec<u8> {
+    // Empty strings impose no constraint. Legacy trim also returns empty when
+    // req contains only empty strings, including when t itself is empty.
+    let patterns: Vec<&[u8]> = req.iter().map(Vec::as_slice).filter(|s| !s.is_empty()).collect();
+    if patterns.is_empty() {
+        return Vec::new();
+    }
+    let matcher = match build(&patterns) {
+        Ok(matcher) => matcher,
+        // The matcher is an optimization. Its representational limits must not
+        // introduce a new rejection of an input the original solver can handle.
+        Err(_) => return trim_reference(t, req),
+    };
+    let mut latest = vec![None; patterns.len()];
+    for found in matcher.find_overlapping_iter(t) {
+        let slot = &mut latest[found.pattern().as_usize()];
+        *slot = Some(slot.map_or(found.start(), |previous: usize| previous.max(found.start())));
+    }
+    // A missing requirement is a caller error: preserve legacy's panic rather
+    // than silently returning an output that omits an input string.
+    let k = latest.into_iter()
+        .map(|position| position.expect("trim input does not contain every required string"))
+        .min().unwrap();
+    let suffix = &t[k..];
+    let mut first_ends = vec![usize::MAX; patterns.len()];
+    for found in matcher.find_overlapping_iter(suffix) {
+        let slot = &mut first_ends[found.pattern().as_usize()];
+        *slot = (*slot).min(found.end());
+    }
+    assert!(first_ends.iter().all(|&end| end != usize::MAX),
+            "trim suffix does not contain every required string");
+    let e = first_ends.into_iter().max().unwrap();
+    suffix[..e].to_vec()
+}
