+    #[test]
+    fn builder_failure_uses_legacy_trim_without_new_rejections() {
+        // BuildError is opaque and the crate exposes no small configurable
+        // build limit. Inject an error from the same fallible-builder seam
+        // instead of allocating gigabytes merely to exhaust state IDs.
+        for (text, req) in [
+            (b"abab".to_vec(), vec![b"ab".to_vec(), b"ba".to_vec()]),
+            (b"aaaaaa".to_vec(), vec![b"aaa".to_vec(), b"aa".to_vec(), b"aaa".to_vec(), vec![]]),
+            ("前缀甲乙甲乙丁后缀".as_bytes().to_vec(),
+             vec!["甲乙".as_bytes().to_vec(), "乙丁".as_bytes().to_vec()]),
+            (vec![0, 255, 0, 128, 255, 0], vec![vec![255, 0], vec![0, 128]]),
+        ] {
+            let called = std::cell::Cell::new(false);
+            let actual = trim_with_builder(&text, &req, |_| {
+                called.set(true);
+                Err::<aho_corasick::AhoCorasick, ()>(())
+            });
+            assert!(called.get(), "forced builder error was not reached");
+            assert_eq!(actual, trim_reference(&text, &req));
+            assert_eq!(actual, brute_trim(&text, &req));
+        }
+        // The fallback preserves the original missing-pattern panic contract.
+        assert!(std::panic::catch_unwind(|| {
+            trim_with_builder(b"abc", &[b"missing".to_vec()], |_| {
+                Err::<aho_corasick::AhoCorasick, ()>(())
+            })
+        }).is_err());
+        // Empty requirements need no matcher, including a failing one.
+        assert_eq!(trim_with_builder::<()>(b"abc", &[vec![]], |_| {
+            panic!("empty requirements must not invoke the builder")
+        }), Vec::<u8>::new());
+    }
