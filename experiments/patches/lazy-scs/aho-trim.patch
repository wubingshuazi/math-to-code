+            let alphabet = [2, 4, 32, 256][case % 4];
+            let length = rng.below(257);
+            let text: Vec<u8> = (0..length).map(|_| rng.below(alphabet) as u8).collect();
+            let mut req = Vec::new();
+            for _ in 0..rng.below(13) {
+                let start = rng.below(text.len() + 1);
+                let end = start + rng.below(text.len() - start + 1);
+                req.push(text[start..end].to_vec());
+                if rng.below(5) == 0 { req.push(req.last().unwrap().clone()); }
+            }
