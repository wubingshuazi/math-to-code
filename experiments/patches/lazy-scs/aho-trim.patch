+    struct Rng(u64);
+    impl Rng {
+        fn below(&mut self, maximum: usize) -> usize {
+            self.0 ^= self.0 << 13;
+            self.0 ^= self.0 >> 7;
+            self.0 ^= self.0 << 17;
+            (self.0 % maximum as u64) as usize
+        }
+    }
