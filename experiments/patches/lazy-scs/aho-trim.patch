+    #[test]
+    fn exhaustive_binary_texts_and_substring_pairs() {
+        for length in 0..=6 {
+            for mask in 0..1 << length {
+                let text: Vec<u8> = (0..length).map(|i| b'a' + ((mask >> i) & 1) as u8).collect();
+                let mut words = vec![vec![]];
+                for start in 0..text.len() {
+                    for end in start + 1..=text.len() { words.push(text[start..end].to_vec()); }
+                }
+                words.sort_unstable();
+                words.dedup();
+                check(&text, &words);
+                for a in &words {
+                    for b in &words { check(&text, &[a.clone(), b.clone()]); }
+                }
+            }
+        }
+    }
