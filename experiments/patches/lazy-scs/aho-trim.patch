+        check(b"abab", &[b"ab".to_vec(), b"ba".to_vec()]);
+        assert_eq!(trim(b"abab", &[b"ab".to_vec(), b"ba".to_vec()]), b"bab");
+        check(b"aaaaaa", &[b"aa".to_vec(), b"aaa".to_vec(), b"aa".to_vec(), vec![]]);
+        check(b"ababa", &[b"aba".to_vec(), b"bab".to_vec(), b"a".to_vec()]);
+        check(b"prefixsuffix", &[]);
+        check(b"prefixsuffix", &[vec![], vec![]]);
+        check(b"", &[]);
+        check(b"", &[vec![], vec![]]);
+        check(b"abc", &[b"abc".to_vec(), b"abc".to_vec()]);
+    }
