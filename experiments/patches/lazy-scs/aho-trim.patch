+#[cfg(test)]
+mod aho_trim_tests {
+    use super::*;
+
+    fn brute_trim(t: &[u8], req: &[Vec<u8>]) -> Vec<u8> {
+        if req.is_empty() { return Vec::new(); }
+        let k = req.iter().map(|word| {
+            (0..=t.len()).rev().find(|&start| {
+                word.len() <= t.len() - start && &t[start..start + word.len()] == word
+            }).expect("missing requirement")
+        }).min().unwrap();
+        let suffix = &t[k..];
+        let end = req.iter().map(|word| {
+            (0..=suffix.len()).find(|&start| {
+                word.len() <= suffix.len() - start && &suffix[start..start + word.len()] == word
+            }).expect("missing suffix requirement") + word.len()
+        }).max().unwrap();
+        suffix[..end].to_vec()
+    }
+
+    fn check(t: &[u8], req: &[Vec<u8>]) {
+        let actual = trim(t, req);
+        assert_eq!(actual, trim_reference(t, req), "legacy byte equality: t={t:?}, req={req:?}");
+        assert_eq!(actual, brute_trim(t, req), "brute byte equality: t={t:?}, req={req:?}");
+        for word in req {
+            assert!(word.is_empty() || actual.windows(word.len()).any(|window| window == word));
+        }
+    }
+
